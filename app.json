{
  "expo": {
    "name": "Daykeep",
    "slug": "day-keep-support",
    "version": "1.32.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "daykeep",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daykeep.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherFinancialInfo",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeHealth",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCoarseLocation",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAnalytics"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.daykeep.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#12805c"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": ["android.permission.ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Daykeep uses Face ID to unlock the app so only you can open it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8fbf9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0e1210",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Daykeep uses your microphone to record voice notes and journal recordings."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Daykeep accesses your photos so you can attach them to notes and journal entries.",
          "cameraPermission": "Daykeep uses your camera so you can capture photos for notes and journal entries."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Daykeep uses your location to tag where a journal entry was written.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366f1",
          "//": "defaultChannel is the channel a REMOTE push lands on when the server names none — the only notifications the app cannot pick a channel for. It is deliberately the fixed 'general' channel rather than one of the tone-specific ones, which come and go as the user changes their reminder sound (see features/notifications/config/notification-sounds.ts). The `sounds` files are copied into res/raw on Android and the app bundle on iOS; they only exist in a NATIVE BUILD made after this entry was added, so a JS-only OTA update ships the picker without the tones and every choice falls back to the system sound.",
          "defaultChannel": "daykeep-general-v3",
          "sounds": [
            "./assets/sounds/daykeep_amber.wav",
            "./assets/sounds/daykeep_aurora.wav",
            "./assets/sounds/daykeep_bamboo.wav",
            "./assets/sounds/daykeep_beacon.wav",
            "./assets/sounds/daykeep_bloom.wav",
            "./assets/sounds/daykeep_bubble.wav",
            "./assets/sounds/daykeep_carillon.wav",
            "./assets/sounds/daykeep_cascade.wav",
            "./assets/sounds/daykeep_chime.wav",
            "./assets/sounds/daykeep_console.wav",
            "./assets/sounds/daykeep_droplet.wav",
            "./assets/sounds/daykeep_ember.wav",
            "./assets/sounds/daykeep_filament.wav",
            "./assets/sounds/daykeep_frost.wav",
            "./assets/sounds/daykeep_halo.wav",
            "./assets/sounds/daykeep_kite.wav",
            "./assets/sounds/daykeep_lantern.wav",
            "./assets/sounds/daykeep_lattice.wav",
            "./assets/sounds/daykeep_ledger.wav",
            "./assets/sounds/daykeep_lyre.wav",
            "./assets/sounds/daykeep_nimbus.wav",
            "./assets/sounds/daykeep_pebble.wav",
            "./assets/sounds/daykeep_ping.wav",
            "./assets/sounds/daykeep_prism.wav",
            "./assets/sounds/daykeep_pulse.wav",
            "./assets/sounds/daykeep_quill.wav",
            "./assets/sounds/daykeep_reed.wav",
            "./assets/sounds/daykeep_relay.wav",
            "./assets/sounds/daykeep_ripple.wav",
            "./assets/sounds/daykeep_sentry.wav",
            "./assets/sounds/daykeep_skyward.wav",
            "./assets/sounds/daykeep_summit.wav",
            "./assets/sounds/daykeep_swoop.wav",
            "./assets/sounds/daykeep_telegraph.wav",
            "./assets/sounds/daykeep_thimble.wav",
            "./assets/sounds/daykeep_thread.wav",
            "./assets/sounds/daykeep_tumble.wav",
            "./assets/sounds/daykeep_vesper.wav",
            "./assets/sounds/daykeep_wool.wav"
          ]
        }
      ],
      "expo-video",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DaykeepToday",
              "label": "Daykeep · Today",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "description": "Tasks due, habits left, and water at a glance",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "DaykeepHabits",
              "label": "Daykeep · Habits",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "description": "Tick today's habits off without opening the app",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-localization",
      "@sentry/react-native",
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "//": "Google's official UNIVERSAL TEST IDs — always serve a self-labeled 'Test Ad', never real inventory, safe to ship in a dev build. Overridden at build time by ADMOB_ANDROID_APP_ID/ADMOB_IOS_APP_ID when set (see app.config.js) — the literal values below are only the fallback for a build with neither set. features/ads/config.ts documents the rest of the swap. See https://developers.google.com/admob/android/test-ads for the current test-id list if these ever change.",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "//skAdNetworkItems": "Apple's SKAdNetwork, iOS install attribution WITHOUT the IDFA — so it keeps working for the users who deny the ATT prompt, which is most of them. Publisher-side these are the buyers allowed to receive a postback for an install that started with an ad in Daykeep; omitting them does not break ads, it just makes this app's iOS inventory worth less to the advertisers who cannot measure it. The list is Google's advised set, taken verbatim from the copy react-native-google-mobile-ads ships in its own docs (node_modules/react-native-google-mobile-ads/docs/index.mdx), which sources https://developers.google.com/ad-manager/mobile-ads-sdk/ios/3p-skadnetworks. Google says outright that these change and should be refreshed periodically — treat a stale list as lost iOS revenue rather than as a bug, and re-check it at the same time as any SDK upgrade.",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork",
            "4fzdc2evr5.skadnetwork",
            "2fnua5tdw4.skadnetwork",
            "ydx93a7ass.skadnetwork",
