{
  "expo": {
    "name": "LifeOS",
    "slug": "LifeOS",
    "version": "1.19.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lifeos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifeos.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherFinancialInfo",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeHealth",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCoarseLocation",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAnalytics"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.lifeos.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#12805c"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": ["android.permission.ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "LifeOS uses Face ID to unlock the app so only you can open it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8fbf9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0e1210",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "LifeOS uses your microphone to record voice notes and journal recordings."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LifeOS accesses your photos so you can attach them to notes and journal entries.",
          "cameraPermission": "LifeOS uses your camera so you can capture photos for notes and journal entries."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LifeOS uses your location to tag where a journal entry was written.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366f1",
          "//": "defaultChannel is the channel a REMOTE push lands on when the server names none — the only notifications the app cannot pick a channel for. It is deliberately the fixed 'general' channel rather than one of the tone-specific ones, which come and go as the user changes their reminder sound (see features/notifications/config/notification-sounds.ts). The `sounds` files are copied into res/raw on Android and the app bundle on iOS; they only exist in a NATIVE BUILD made after this entry was added, so a JS-only OTA update ships the picker without the tones and every choice falls back to the system sound.",
          "defaultChannel": "lifeos-general-v3",
          "sounds": [
            "./assets/sounds/lifeos_amber.wav",
            "./assets/sounds/lifeos_aurora.wav",
            "./assets/sounds/lifeos_bamboo.wav",
            "./assets/sounds/lifeos_beacon.wav",
            "./assets/sounds/lifeos_bloom.wav",
            "./assets/sounds/lifeos_bubble.wav",
            "./assets/sounds/lifeos_carillon.wav",
            "./assets/sounds/lifeos_cascade.wav",
            "./assets/sounds/lifeos_chime.wav",
            "./assets/sounds/lifeos_console.wav",
            "./assets/sounds/lifeos_droplet.wav",
            "./assets/sounds/lifeos_ember.wav",
            "./assets/sounds/lifeos_filament.wav",
            "./assets/sounds/lifeos_frost.wav",
            "./assets/sounds/lifeos_halo.wav",
            "./assets/sounds/lifeos_kite.wav",
            "./assets/sounds/lifeos_lantern.wav",
            "./assets/sounds/lifeos_lattice.wav",
            "./assets/sounds/lifeos_ledger.wav",
            "./assets/sounds/lifeos_lyre.wav",
            "./assets/sounds/lifeos_nimbus.wav",
            "./assets/sounds/lifeos_pebble.wav",
            "./assets/sounds/lifeos_ping.wav",
            "./assets/sounds/lifeos_prism.wav",
            "./assets/sounds/lifeos_pulse.wav",
            "./assets/sounds/lifeos_quill.wav",
            "./assets/sounds/lifeos_reed.wav",
            "./assets/sounds/lifeos_relay.wav",
            "./assets/sounds/lifeos_ripple.wav",
            "./assets/sounds/lifeos_sentry.wav",
            "./assets/sounds/lifeos_skyward.wav",
            "./assets/sounds/lifeos_summit.wav",
            "./assets/sounds/lifeos_swoop.wav",
            "./assets/sounds/lifeos_telegraph.wav",
            "./assets/sounds/lifeos_thimble.wav",
            "./assets/sounds/lifeos_thread.wav",
            "./assets/sounds/lifeos_tumble.wav",
            "./assets/sounds/lifeos_vesper.wav",
            "./assets/sounds/lifeos_wool.wav"
          ]
        }
      ],
      "expo-video",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LifeOSToday",
              "label": "LifeOS · Today",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "description": "Tasks due, habits left, and water at a glance",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "LifeOSHabits",
              "label": "LifeOS · Habits",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "description": "Tick today's habits off without opening the app",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-localization",
      "@sentry/react-native",
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "//": "Google's official UNIVERSAL TEST IDs — always serve a self-labeled 'Test Ad', never real inventory, safe to ship in a dev build. Overridden at build time by ADMOB_ANDROID_APP_ID/ADMOB_IOS_APP_ID when set (see app.config.js) — the literal values below are only the fallback for a build with neither set. features/ads/config.ts documents the rest of the swap. See https://developers.google.com/admob/android/test-ads for the current test-id list if these ever change.",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "LifeOS uses this to show fewer, more relevant ads on the free plan. Denying it still shows ads — Plus removes them either way."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09e67cd7-58a6-4a88-ad76-93463d25dc51"
      }
    },
    "owner": "nadirhusaain"
  }
}
