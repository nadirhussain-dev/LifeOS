# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Database connection strings for `npm run migrate` — a Postgres URL carries the
# password for a role that bypasses row level security, so this is the one file
# here whose leak is total rather than partial. `.env.db.example` is the
# committed template and is deliberately NOT matched by this line.
.env.db

# EAS submit credentials (Google Play service account) — never commit
google-play-service-account.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI local state (per-machine project link, not for source control)
supabase/.temp/

# Edge function secrets pushed by `npm run secrets:push` — the Resend key sends
# mail as our domain, and the Expo token pushes to our users. Already covered by
# the bare `.env` rule above (it matches at any depth); named explicitly because
# these are server-side secrets, a different class to the app's build-time env,
# and `supabase/.env.example` is the committed template.
supabase/.env

# Claude Code personal overrides (permission mode, local allowlists). The
# shared settings.json is checked in; this one must not be — it is per-machine,
# and a committed "bypassPermissions" would auto-approve tool calls for anyone
# who clones the repo.
.claude/settings.local.json
.claude/settings.json.tmp*
