# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# EAS submit credentials (Google Play service account) — never commit
google-play-service-account.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Claude Code personal overrides (permission mode, local allowlists). The
# shared settings.json is checked in; this one must not be — it is per-machine,
# and a committed "bypassPermissions" would auto-approve tool calls for anyone
# who clones the repo.
.claude/settings.local.json
.claude/settings.json.tmp*
