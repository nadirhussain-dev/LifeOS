# Daykeep environment — copy this file to `.env` and fill in your values.
#
# Setup:
#   1. Create a Supabase project at https://supabase.com.
#   2. In the SQL editor, run supabase/migrations/0001_init.sql
#      (creates the profiles + sync tables with Row Level Security).
#   3. Copy the values below from Project Settings > API.
#
# The EXPO_PUBLIC_ prefix is required for Expo to inline these at build time.
# The anon key is safe to expose client-side: it only grants what your
# Postgres Row Level Security policies allow (each user sees only their rows).
#
# Without valid values, sign-in and sync won't work (guest mode still does).

# ---------------------------------------------------------------------------
# Which environment this build is for: development | staging | production
# ---------------------------------------------------------------------------
# Decides the app id, the app name, the deep-link scheme and the in-app
# environment badge — not just a label. A `staging` build installs as
# com.daykeep.app.staging, named "Daykeep (Staging)", so it sits next to the
# real app on a phone instead of replacing it (scripts/build-env.js).
#
# Leave it as `development` locally. For EAS it is set per environment, next to
# the Supabase credentials, and a release build without it FAILS — see
# docs/ENVIRONMENTS.md for the full walkthrough.
EXPO_PUBLIC_APP_ENV=development

# The Supabase project this build talks to. STAGING AND PRODUCTION ARE TWO
# DIFFERENT PROJECTS: point your local .env at staging, and never at production.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: where the password-reset email links back to. Leave blank to use
# the app's built-in `daykeep://reset-password` deep link. If you set a custom
# value, also add it to your Supabase Auth "Redirect URLs" allow-list.
EXPO_PUBLIC_SUPABASE_REDIRECT_URL=

# Optional: Sentry DSN for production crash/error reporting. Leave blank to keep
# errors local-only (console + dev banner). Create a project at sentry.io.
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Published policies and support contact
# ---------------------------------------------------------------------------
# All three have working defaults, so a build with these blank is still
# submittable — the defaults point at the GitHub Pages site published by
# .github/workflows/pages.yml from PRIVACY.md and TERMS.md.
#
# Override them when you move the documents to your own domain. Both stores
# require a privacy policy at a stable, publicly reachable URL that cannot be
# edited in place, and a support address that actually receives mail.
#
# Defaults:
#   https://nadirhussain786.github.io/Daykeep/privacy/
#   https://nadirhussain786.github.io/Daykeep/terms/
#   daykeepsupport@gmail.com
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Vault escrow — OPERATOR ACCESS TO USERS' PRIVATE SPACES
# ---------------------------------------------------------------------------
# Base64 X25519 PUBLIC key. When set, every private space's master key is also
# sealed to it and uploaded, so staff can open any signed-in user's Vault,
# Cycle, Recovery and Us data (supabase/migrations/0015).
#
# Generate the pair OFFLINE with generateOperatorKeypair() in
# features/private/services/vault-escrow.ts. Only the PUBLIC half belongs here.
#
# ⚠️  The private half must never be committed, and must never live on the same
# platform as the database — it is the one secret that turns every escrow row
# into plaintext. Keep it in an HSM or an offline password manager.
#
# ⚠️  Leaving this EMPTY keeps Daykeep end-to-end encrypted: no key is uploaded
# and nobody but the user can open their private space. That is the safe
# default, and the in-app operator-access warning is hidden when it is unset.
EXPO_PUBLIC_VAULT_ESCROW_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# EAS builds — docs/ENVIRONMENTS.md is the full guide
# ---------------------------------------------------------------------------
# Local `.env` is NOT uploaded to EAS. Each build profile in eas.json is linked
# to an EAS environment ("development" | "preview" | "production"), and a build
# sees only that environment's variables. EAS's "preview" IS our staging.
#
# Set the three together, per environment, so they cannot drift apart:
#   eas env:set --environment preview --name EXPO_PUBLIC_APP_ENV --value "staging"
#   eas env:set --environment preview --name EXPO_PUBLIC_SUPABASE_URL --value "https://<staging>.supabase.co"
#   eas env:set --environment preview --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "..."
#
#   eas env:set --environment production --name EXPO_PUBLIC_APP_ENV --value "production"
#   eas env:set --environment production --name EXPO_PUBLIC_SUPABASE_URL --value "https://<prod>.supabase.co"
#   eas env:set --environment production --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "..."
#
# Keeping APP_ENV next to the credentials is what lets app.config.js catch a
# build that is reading the WRONG environment's variables: they travel together,
# so a production build picking up preview's values arrives declaring "staging",
# and the build fails instead of shipping against the staging database.
#
# (Do NOT re-add `env` blocks to eas.json — empty/blank values there would
# shadow these EAS-managed variables.)
#
# Verify what an environment actually holds BEFORE building — a variable that
# exists but is assigned to a different environment is invisible to the build,
# and that is the usual reason a build comes out with no working credentials:
#   npm run env:staging          # eas env:list --environment preview
#   npm run env:production
#
# Build with:
#   npm run build:staging
#   npm run build:production
#
# app.config.js fails a staging/production build outright when the required
# variables are absent, and prints these commands. Previously such a build
# succeeded and produced an APK that installed fine but could not sign anyone
# in — the bundler treats an unset EXPO_PUBLIC_ var as an empty string, so
# nothing anywhere flagged it.

# ---------------------------------------------------------------------------
# AdMob — optional. Unset means every ad slot keeps showing Google's own
# universal TEST ad (self-labeled "Test Ad" by the SDK, never real inventory,
# safe to ship). Set these before a real store release — see
# features/ads/config.ts for the full story.
# ---------------------------------------------------------------------------
# App IDs — BUILD-TIME ONLY, no EXPO_PUBLIC_ prefix. Consumed by the
# react-native-google-mobile-ads config plugin (app.config.js), never read
# from JS, so — like SENTRY_ORG/SENTRY_PROJECT below — Expo's inlining rule
# doesn't apply. One per platform, from AdMob console > Apps > App settings:
#   ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# Banner ad unit ids — read from JS at runtime (features/ads/components/
# ad-slot.tsx), so these DO need the EXPO_PUBLIC_ prefix. AdMob issues a
# separate unit id per platform even for "the same" placement:
#   ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_IOS=

# For EAS builds, set per environment same as everything else here, e.g.:
#   eas env:set --environment production --name ADMOB_ANDROID_APP_ID --value "ca-app-pub-...~..."
#   eas env:set --environment production --name ADMOB_IOS_APP_ID --value "ca-app-pub-...~..."
#   eas env:set --environment production --name EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_ANDROID --value "ca-app-pub-.../..."
#   eas env:set --environment production --name EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_IOS --value "ca-app-pub-.../..."

# ---------------------------------------------------------------------------
# Sentry source-map upload — BUILD-TIME ONLY, and OPTIONAL. Separate from the
# public DSN above. The @sentry/react-native plugin uses these during `eas
# build` to upload source maps so production stack traces are readable rather
# than minified.
#
# Left unset, nothing breaks: eas.json sets SENTRY_DISABLE_AUTO_UPLOAD=true on
# every build profile, so the upload is skipped and the build succeeds. Without
# that flag an unset token is FATAL, not a warning — sentry-cli exits 1 with
# "An organization ID or slug is required (provide with --org)" and Gradle
# fails. That is why the flag is there rather than a note telling you to be
# careful.
#
# To turn readable stack traces ON, both steps are needed:
#   1. set the three variables below in the production EAS environment
#   2. remove SENTRY_DISABLE_AUTO_UPLOAD from the "production" profile in
#      eas.json — step 1 alone does nothing, and app.config.js says so in the
#      build log if it sees the variables set while the flag is still on.
#
# Token: sentry.io > Settings > Auth Tokens (scope: project:releases).
#   eas env:set --environment production --name SENTRY_AUTH_TOKEN --value "..." --visibility secret
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Supabase Edge Functions — SERVER-SIDE, see supabase/.env.example
# ---------------------------------------------------------------------------
# Nothing for the functions belongs in this file, in `.env`, or in EAS. EAS
# variables are for an app BUILD, and no build can reach a function's
# environment — a key set there is simply never read. See supabase/.env.example
# for the ones you set by hand (Resend, Expo push) and how to push them:
#
#   cp supabase/.env.example supabase/.env    # paste values, then:
#   npm run secrets:push
#
# These three are injected into every function automatically and must NOT be
# set by hand — the `SUPABASE_` prefix is reserved and the push is rejected:
#   SUPABASE_URL              (auto-injected)
#   SUPABASE_ANON_KEY         (auto-injected — acts as the caller, so RLS applies)
#   SUPABASE_SERVICE_ROLE_KEY (auto-injected — full-access key, never client-side)
#
# Deploy a function with:  supabase functions deploy <name>
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Turning Resend on in one step — scripts/configure-resend-smtp.mjs
# ---------------------------------------------------------------------------
#   npm run configure:resend-smtp -- --dry-run   # prints the plan
#   npm run configure:resend-smtp                # applies it
#
# Does the three things that otherwise have to be clicked through by hand:
# pushes the send-invite secrets, points Auth SMTP at smtp.resend.com, and
# re-applies the branded templates from supabase/templates/.
#
# That third step is the one worth knowing about. A free-tier project REFUSES
# custom email templates while it is still on Supabase's default mailer —
# saving one fails with "Email template modification is not available for free
# tier projects using the default email provider". Configuring any custom SMTP
# lifts the restriction; it is replacing the default provider that matters, not
# paying. So the templates cannot be pasted before SMTP is set, which is not
# the order the dashboard suggests.
#
# The Resend values themselves live in `supabase/.env`, NOT here — they are
# edge-function secrets and supabase/.env.example explains at length why this
# file is the wrong home for them.
#
# Three operator credentials DO belong here. None carries an EXPO_PUBLIC_
# prefix, and that is the whole safety argument: Metro inlines a variable into
# the app bundle by literal prefix match, so a name without one is never seen
# by the app no matter which file it sits in. This file is gitignored.
#
#   SUPABASE_ACCESS_TOKEN
#     Account-level PAT from supabase.com/dashboard/account/tokens. Reaches the
#     Management API, and therefore both projects — treat it accordingly.
#
#   GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET
#     A **Web application** OAuth client (Cloud Console → Credentials). Web,
#     not Android: features/auth/services/oauth.ts uses the browser PKCE flow,
#     so Google only ever sees Supabase's callback and never the app itself —
#     no package id, no SHA-1, and one client can serve both projects provided
#     both callbacks are registered on it:
#       https://<staging-ref>.supabase.co/auth/v1/callback
#       https://<production-ref>.supabase.co/auth/v1/callback
#     Leave both unset and the script skips Google, leaving the provider
#     untouched rather than switching it off.
#
# SUPABASE_ACCESS_TOKEN=sbp_...
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Safepay (safepay-checkout / safepay-webhook / safepay-cancel-subscription)
# — SERVER-SIDE ONLY. The client never talks to Safepay directly, only to
# these three edge functions, so none of this is EXPO_PUBLIC_ and none of it
# belongs in this file. Set it as Supabase Function secrets instead:
#
#   supabase secrets set SAFEPAY_API_KEY=...
#   supabase secrets set SAFEPAY_SECRET_KEY=...
#   supabase secrets set SAFEPAY_WEBHOOK_SECRET=...
#   supabase secrets set SAFEPAY_ENVIRONMENT=sandbox   # or "production"
#   supabase secrets set SAFEPAY_RETURN_BASE_URL=daykeep://billing/callback
#
# API key and secret key come from the Safepay dashboard for the merchant
# account being used (sandbox and production are separate credentials). The
# webhook secret comes from the dashboard's Webhooks section once the
# `safepay-webhook` function's URL is registered there — register it with
# `supabase functions deploy safepay-webhook --no-verify-jwt` first so the URL
# exists to register.
#
# See supabase/functions/_shared/safepay.ts's header and this feature's
# implementation plan for what's confirmed against Safepay's own docs/SDK
# versus what to verify against the live API reference before a production
# deploy (Plan-creation's exact request/response shape is the one open item).
# ---------------------------------------------------------------------------
# Database URLs for `npm run migrate` — see .env.db.example
# ---------------------------------------------------------------------------
# SUPABASE_DB_URL_STAGING and SUPABASE_DB_URL_PRODUCTION live in `.env.db`
# (gitignored) rather than here:
#
#   cp .env.db.example .env.db     # then fill in both connection strings
#
# Kept in a separate file on purpose, so the file Expo reads and the file
# holding a database password are not the same file. A Postgres URL carries the
# password for a role that bypasses row level security entirely, which makes it
# the one secret in this project whose leak is total rather than partial.
#
# The runner still accepts them from `.env` as a fallback, and a shell export or
# CI secret beats both (scripts/db-env.mjs). Whichever file they end up in, the
# rule that keeps them out of the APK is that they have no EXPO_PUBLIC_ prefix —
# Metro inlines only prefixed names. Never add one.
#
#   npm run migrate:status              # what is applied where
#   npm run migrate:staging             # apply everything pending to staging
#   npm run migrate:production          # prints the plan, then asks
